# Example server{} locations. Check for an existing callback handler before use.
location = /pan/mcp {
    access_log off;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:8201;
}
location = /pan/authorize {
    access_log off;
    proxy_http_version 1.1;
