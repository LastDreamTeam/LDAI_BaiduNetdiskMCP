  "author": {
    "name": "LastDreamTeam"
  },
  "repository": "https://github.com/LastDreamTeam/LDAI_BaiduNetdiskMCP",
  "homepage": "https://github.com/LastDreamTeam/LDAI_BaiduNetdiskMCP",
  "license": "AGPL-3.0-only",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "百度网盘",
        "shortDescription": "查询和管理已授权的网盘文件",
        "longDescription": "通过 bdpan 和可选的开放平台 OAuth 查询、上传、下载和管理使用者自己的网盘文件。",
        "developerName": "LastDreamTeam",
        "category": "Productivity",
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg",
